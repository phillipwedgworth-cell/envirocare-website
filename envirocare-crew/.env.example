# Required API Keys — copy this to .env (never commit .env)

# Anthropic (Claude Opus for design_advisor, site_auditor, critic)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o for competitor_analyst)
OPENAI_API_KEY=sk-...

# Google (Gemini 2.5 Pro for content_strategist)
GOOGLE_API_KEY=...

# Serper (Google search for competitor_analyst web_search tool)
SERPER_API_KEY=...

# Supabase (write findings to command center dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Optional: Resend (email digest after crew run)
RESEND_API_KEY=re_...
NOTIFY_EMAIL=phillipwedgworth@gmail.com
