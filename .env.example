# EnviroCare — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Core ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
NOTIFY_EMAIL=phillipwedgworth@gmail.com
NOTIFY_FROM=agents@envirocarellc.com
# Before DNS flip use: NOTIFY_FROM=onboarding@resend.dev

# ── EnviroCare SEO ────────────────────────────────────────────────────────────
LOCAL_FALCON_API_KEY=...
# Find in: Local Falcon → Settings → API

BRIGHTLOCAL_API_KEY=...
# Find in: BrightLocal → Settings → API Access

# ── Personal / Health ─────────────────────────────────────────────────────────
OURA_TOKEN=
# Get from: cloud.ouraring.com → Personal Access Tokens

# ── Supabase (agent state storage + logging) ──────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
# Find both at: supabase.com/dashboard/project/<ref>/settings/api
# Use the SERVICE ROLE key (not anon) — bypasses RLS
# Run agents/lib/supabase-schema.sql once in Supabase SQL editor to create tables

# ── Next.js / Website ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://envirocarellc.com
