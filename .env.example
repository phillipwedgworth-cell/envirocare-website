# EnviroCare — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local to git.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
# Use the SERVICE ROLE key (not anon). Also accepted as SUPABASE_SERVICE_ROLE_KEY.
# Find at: supabase.com/dashboard/project/<ref>/settings/api
# Run agents/supabase-seo-history-schema.sql + agents/supabase-scaling-simple.sql once.

RESEND_API_KEY=re_...
NOTIFY_EMAIL=phillipwedgworth@gmail.com
NOTIFY_FROM=agents@envirocarellc.com

NEXT_PUBLIC_SITE_URL=https://envirocarellc.com

# ── VERCEL KV (chat conversation logging) ────────────────────────────────────
# Auto-injected when a KV store is linked in Vercel Dashboard → Storage.
# KV_REST_API_URL=    (auto)
# KV_REST_API_TOKEN=  (auto)
LOGS_AUTH_KEY=        # openssl rand -hex 32

# ── LOCAL SEO + RANKINGS ──────────────────────────────────────────────────────
BRIGHTLOCAL_API_KEY=...
LOCAL_FALCON_API_KEY=...
PAGESPEED_API_KEY=...

# ── CRM + LEAD CAPTURE ───────────────────────────────────────────────────────
FIELDSTER_API_TOKEN=...
FORMSPREE_LEAD_URL=https://formspree.io/f/...

# ── AGENT INFRASTRUCTURE ─────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── MULTI-MODEL PANEL (OPTIONAL) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ── GOOGLE INTEGRATIONS (OPTIONAL) ───────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=...
GOOGLE_DRIVE_API_KEY=...
GOOGLE_DRIVE_ACCESS_TOKEN=...   # also accepted as GOOGLE_OAUTH_ACCESS_TOKEN

# ── SETUP ORDER ──────────────────────────────────────────────────────────────
# 1. Set REQUIRED vars in Vercel → Project Settings → Environment Variables (Production + Preview)
# 2. Link KV store: Vercel Dashboard → Storage → Create KV → link project → set LOGS_AUTH_KEY
# 3. Run SQL schemas in Supabase SQL editor (agents/supabase-*-schema.sql files)
# 4. Deploy and hit /api/agents/health — should return ok:true with no missingRequired
