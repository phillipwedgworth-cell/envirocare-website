# EnviroCare — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local to git.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
# Use the SERVICE ROLE key (not anon). Also accepted as SUPABASE_SERVICE_ROLE_KEY
# or SUPABASE_SERVICE_KEY (daily-rollup.mjs + morning-brief.mjs read that name).
# Set all three to the same service-role value to be safe.
# Find at: supabase.com/dashboard/project/<ref>/settings/api
# Run agents/supabase-seo-history-schema.sql + agents/supabase-scaling-simple.sql once.

RESEND_API_KEY=re_...
NOTIFY_EMAIL=phillipwedgworth@gmail.com
NOTIFY_FROM=agents@envirocarellc.com

NEXT_PUBLIC_SITE_URL=https://envirocarellc.com

# ── VERCEL KV (chat conversation logging) ────────────────────────────────────
# Auto-injected when a KV store is linked in Vercel Dashboard → Storage.
# KV_REST_API_URL=    (auto)
# KV_REST_API_TOKEN=  (auto)
LOGS_AUTH_KEY=        # openssl rand -hex 32

# ── LOCAL SEO + RANKINGS ──────────────────────────────────────────────────────
BRIGHTLOCAL_API_KEY=...
LOCAL_FALCON_API_KEY=...
PAGESPEED_API_KEY=...

# ── CRM + LEAD CAPTURE ───────────────────────────────────────────────────────
FIELDSTER_API_TOKEN=...
FORMSPREE_LEAD_URL=https://formspree.io/f/...

# ── AGENT INFRASTRUCTURE ─────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
CRON_SECRET=          # openssl rand -hex 32 — guards /api/*/run cron endpoints
COMMAND_CENTER_KEY=   # gate for /command-center?key=… — openssl rand -hex 16 (repo is public, so this MUST be set)

# ── ANALYTICS INGEST (GA4 / Search Console) ──────────────────────────────────
GA4_PROPERTY_ID=      # numeric GA4 property id — required by agents/ingest-ga4.mjs
# GSC_SITE_URL=sc-domain:envirocarellc.com   # optional, this is the default

# ── DEPLOY MONITORING (agents/watchdog.mjs) ──────────────────────────────────
VERCEL_TOKEN=         # vercel.com/account/tokens — required to read deploy status
# VERCEL_PROJECT_ID=  # optional, defaults to the envirocare-web project id
# VERCEL_TEAM_ID=     # optional, defaults to the envirocare team slug
# DAILY_USD_BUDGET=5  # optional soft cap on agent AI spend (default 5)

# ── SEO CONTENT TOOLS (OPTIONAL) ────────────────────────────────────────────
NEURONWRITER_API_KEY=...
# NEURONWRITER_PROJECT=  # NeuronWriter project id (has a built-in default)

# ── NOTION REPORTING (OPTIONAL) ──────────────────────────────────────────────
# Integration token from notion.so/my-integrations — must be shared with the target page.
# Used by neuronwriter-qa to post weekly scores to the NeuronWriter QA Notion page.
NOTION_TOKEN=secret_...
# NOTION_AGENT_DB_ID=    # Notion database id the agent notifier writes runs to

# ── EMAIL EXTRAS (OPTIONAL) ──────────────────────────────────────────────────
# All fall back to NOTIFY_EMAIL / NOTIFY_FROM above when unset.
# ALERT_EMAIL=           # comma-separated recipients for watchdog/alert emails
# RESEND_FROM=           # overrides the From: address for ad-draft emails
# DIGEST_TO=             # comma-separated recipients for the SEO snapshot digest
# DIGEST_FROM=EnviroCare SEO <onboarding@resend.dev>

# ── MULTI-MODEL PANEL (OPTIONAL) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ── SOCIAL POSTING (agents/social-poster.mjs) ────────────────────────────────
# Facebook / Instagram via the Meta Graph API. Clients no-op until these are set.
META_PAGE_ID=            # Facebook Page numeric id
META_PAGE_TOKEN=         # long-lived Page token (pages_manage_posts, instagram_content_publish)
IG_BUSINESS_ID=          # optional — Instagram Business account id
# Google Business Profile local posts (reuses the GSC/GA4 Google OAuth app below).
# NOTE: the Business Profile API is access-restricted — request quota on your GCP project.
GOOGLE_CLIENT_ID=        # also used by GSC/GA4 ingest
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GBP_ACCOUNT_ID=          # accounts/XXXX
GBP_LOCATION_HUNTSVILLE= # locations/XXXX
GBP_LOCATION_BIRMINGHAM=
GBP_LOCATION_LAKE_MARTIN=

# ── GOOGLE INTEGRATIONS (OPTIONAL) ───────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=...
GOOGLE_DRIVE_API_KEY=...
GOOGLE_DRIVE_ACCESS_TOKEN=...   # also accepted as GOOGLE_OAUTH_ACCESS_TOKEN

# ── SETUP ORDER ──────────────────────────────────────────────────────────────
# 1. Set REQUIRED vars in Vercel → Project Settings → Environment Variables (Production + Preview)
# 2. Link KV store: Vercel Dashboard → Storage → Create KV → link project → set LOGS_AUTH_KEY
# 3. Run SQL schemas in Supabase SQL editor (agents/supabase-*-schema.sql files)
# 4. Deploy and hit /api/agents/health — should return ok:true with no missingRequired
