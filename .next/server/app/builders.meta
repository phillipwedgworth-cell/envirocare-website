{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/builders/layout,_N_T_/builders/page,_N_T_/builders"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/builders/__PAGE__",
    "/builders",
    "/_index",
    "/_head"
  ]
}