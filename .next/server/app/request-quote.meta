{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/request-quote/layout,_N_T_/request-quote/page,_N_T_/request-quote"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/request-quote/__PAGE__",
    "/request-quote",
    "/_index",
    "/_head"
  ]
}