{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/services/layout,_N_T_/services/flea/layout,_N_T_/services/flea/page,_N_T_/services/flea"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/services/flea/__PAGE__",
    "/services/flea",
    "/services",
    "/_index",
    "/_head"
  ]
}