{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/services/layout,_N_T_/services/crawlspace/layout,_N_T_/services/crawlspace/page,_N_T_/services/crawlspace"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/services/crawlspace/__PAGE__",
    "/services/crawlspace",
    "/services",
    "/_index",
    "/_head"
  ]
}